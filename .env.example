# Password required to access /admin/*. Compared server-side with a timing-safe hash comparison.
SITE_PASSWORD=

# Secret used to sign the session JWT cookie (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Optional. Fine-grained GitHub PAT scoped to Contents: Read and write, limited to this repo only.
# UNSET (default): form submissions write directly to the local filesystem — safe, normal local dev.
# SET: form submissions commit directly to the GitHub repo via the Contents API and push to GITHUB_BRANCH,
#      which triggers a real Vercel deploy. WARNING: setting this locally means the form creates REAL
#      commits against the live repository, not a sandbox — only set locally when intentionally testing
#      the production commit path end-to-end (ideally against a disposable throwaway repo, not this one).
GITHUB_TOKEN=

# Required only when GITHUB_TOKEN is set.
GITHUB_REPO_OWNER=FakehZps
GITHUB_REPO_NAME=claude-code-webpage
GITHUB_BRANCH=master
